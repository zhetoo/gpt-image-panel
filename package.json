{
  "scripts": {
    "frontend:dev": "pnpm --dir frontend run dev",
    "frontend:build": "pnpm --dir frontend run build",
    "frontend:check": "pnpm --dir frontend run check",
    "backend:dev": "granian --interface asgi backend.app.main:app --host 0.0.0.0 --port 9090 --reload",
    "test:contract": ".venv/bin/python -m pytest backend/tests/test_*_contract.py -q",
    "test:e2e": "pnpm --dir frontend run test:e2e",
    "test:e2e:perf": "pnpm --dir frontend run test:e2e:perf",
    "test:perf": "RUN_PERFORMANCE_TESTS=true .venv/bin/python -m pytest backend/tests/test_performance.py -q"
  }
}
